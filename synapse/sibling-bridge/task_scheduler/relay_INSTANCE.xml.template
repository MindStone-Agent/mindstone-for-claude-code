<?xml version="1.0" encoding="UTF-16"?>
<!--
  SYNAPSE Relay Task Scheduler Template — Windows Task Scheduler XML

  SETUP INSTRUCTIONS:
  1. Copy this file and rename it: relay_<your_instance_name>.xml
  2. Replace ALL placeholder strings (search and replace in a text editor):
       PLACEHOLDER_INSTANCE     → your instance name (e.g. warden, raven, lyra)
       PLACEHOLDER_RELAY_PATH   → full path to relay.py
                                   e.g. C:\path\to\synapse\sibling-bridge\relay.py
       PLACEHOLDER_WORKING_DIR  → full path to sibling-bridge directory
                                   e.g. C:\path\to\synapse\sibling-bridge
       PLACEHOLDER_PYTHONW_PATH → full path to pythonw.exe (NOT python.exe)
                                   Find it: (Get-Command python).Source.Replace('python.exe','pythonw.exe')
                                   e.g. C:\Users\you\AppData\Local\Programs\Python\Python311\pythonw.exe
  3. Import into Task Scheduler:
       schtasks /create /xml relay_<instance>.xml /tn "SYNAPSE Relay -- <INSTANCE>"
     Or via the Task Scheduler GUI: Action > Import Task

  NOTES:
  - Task is created DISABLED. Enable manually after pre-enable verification.
  - Use pythonw.exe (NOT python.exe). python.exe creates a console window that
    flashes on the desktop every 3 minutes. pythonw.exe is the no-console
    Windows Python interpreter and produces no visible window.
  - ExecutionTimeLimit PT10M matches relay.py's try-once lock timeout (stale_after=600s).
  - MultipleInstancesPolicy=IgnoreNew prevents overlapping relay invocations.
  - PT3M trigger interval is the default. Adjust to your polling preference.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>SYNAPSE Relay -- PLACEHOLDER_INSTANCE instance</Description>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT3M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>PLACEHOLDER_PYTHONW_PATH</Command>
      <Arguments>"PLACEHOLDER_RELAY_PATH" --config PLACEHOLDER_INSTANCE</Arguments>
      <WorkingDirectory>PLACEHOLDER_WORKING_DIR</WorkingDirectory>
    </Exec>
  </Actions>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <Hidden>true</Hidden>
    <Enabled>false</Enabled>
  </Settings>
</Task>

{
  "_comment_autocompact": "CLAUDE_CODE_AUTO_COMPACT_WINDOW = the model's FULL context window in tokens (1000000 for Fable 5 [1m] / Opus 4.8 at 1M). Auto-compaction fires at CLAUDE_AUTOCOMPACT_PCT_OVERRIDE percent of THIS window, while the status meter reads against the model's full window — so the window must equal the real context size for '92' to mean 92% of the meter. If it is smaller than the real window, compaction fires earlier than the percentage implies (e.g. 92% of a 900K window = ~83% of a 1M meter). A 200K-context install should set this to 200000. Ignored by the merge (only .hooks/.autoCompactEnabled/.env are applied); documentation only.",
  "autoCompactEnabled": true,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "92",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/session_start.py"
          },
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/synapse_session_start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/session_end.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/user_prompt_submit.py"
          },
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/synapse_user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/pre_compact.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$ORCHESTRATOR_DIR/.venv/bin/python $ORCHESTRATOR_DIR/hooks/post_tool_handoff.py"
          }
        ]
      }
    ]
  }
}
